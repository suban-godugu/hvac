# Copy to .env and fill locally. Never commit secrets.

HVAC_ENV=development
HVAC_DEPLOYMENT_MODE=local
HVAC_ALLOW_DEFAULT_USERS=0
HVAC_DEFAULT_BUILDING_ID=bldg-corp-hq-01

HVAC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

HVAC_SAFE_MODE=0
HVAC_BMS_MODE=simulation
HVAC_BMS_PROTOCOL=bacnet
HVAC_BMS_CONNECTED=0
HVAC_BMS_WRITE_ENABLED=0
HVAC_ALLOW_SIM_WRITES=0
HVAC_USE_SIMULATION=0
HVAC_START_CONTROL_WORKER=1
# Production: 0. Development may set 1 until all tables are in Alembic.
HVAC_ALLOW_CREATE_ALL=0
HVAC_ALLOW_DB_RESET=0
HVAC_TELEMETRY_STALE_SECONDS=90
HVAC_DISPATCH_CONFIDENCE_MIN=0.65
HVAC_TELEMETRY_RETAIN_DAYS=90
HVAC_TELEMETRY_PURGE=0

# Production BMS (leave unset unless a real gateway is bound)
# HVAC_BACNET_HOST=
# HVAC_BACNET_PORT=47808
# HVAC_MQTT_URL=
# HVAC_OPCUA_URL=

OPENWEATHER_API_KEY=
FACILITY_NAME=Skyline Corporate Center
FACILITY_CITY=Bengaluru
FACILITY_LOCATION=Bengaluru, Karnataka, India
FACILITY_TIMEZONE=Asia/Kolkata
FACILITY_LAT=12.9716
FACILITY_LON=77.5946

NEXT_PUBLIC_API_URL=http://localhost:8000/api
